{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "playwright": {
    "config": [],
    "entry": ["playwright.config.ts", "e2e/**/*.spec.ts"]
  },
  "ignore": [".storybook/public/mockServiceWorker.js"],
  "ignoreUnresolved": [
    "@/lib/generated/docs",
    "./seeded-users.generated",
    "../support/seeded-users.generated"
  ],
  "rules": {
    "exports": "off",
    "nsExports": "off",
    "types": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off"
  }
}
