{
  "name": "hatchet-docs",
  "version": "0.0.1",
  "description": "Hatchet documentation",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "taskfile-dev": "pnpm run generate-examples && pnpm run generate-llms && pnpm run test-search -- --warn && next dev",
    "dev": "pnpm run generate-llms && pnpm run test-search -- --warn && next dev",
    "build": "pnpm run generate-examples && pnpm run generate-llms && pnpm run test-search && NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint:check": "npm run prettier:check",
    "lint:fix": "npm run prettier:fix",
    "prettier:check": "prettier \"(content|components|app)/**/*.{tsx,mdx,js,ts}\" --list-different",
    "prettier:fix": "prettier \"(content|components|app)/**/*.{tsx,mdx,js,ts}\" --write",
    "generate-llms": "tsx scripts/generate-llms.ts",
    "test-search": "tsx scripts/test-search-quality.ts",
    "generate-examples": "cd ../snippets/ && python -X utf8 generate.py || python3 -X utf8 generate.py",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/js-yaml": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "estree-util-value-to-estree": "^3.4.0",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.0",
    "js-yaml": "^4.3.1",
    "loops": "^5.0.1",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.16.1",
    "minisearch": "^7.2.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.294.0",
    "posthog-node": "^5.24.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-lottie-player": "^2.1.0",
    "react-tweet": "^3.2.2",
    "recharts": "^2.15.4",
    "shiki": "^1.29.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "nanoid": "^3.3.17",
    "katex": "^0.16.21"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "prismjs": "^1.30.0",
      "mdast-util-to-hast": ">=13.2.1",
      "tar": "^7.5.8",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "swagger-ui-react>js-yaml": "^4.3.1",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid": "^3.3.17",
      "axios": "^1.18.0",
      "uuid": "^13.0.1",
      "@xmldom/xmldom": "^0.8.13",
      "follow-redirects": "^1.16.0",
      "brace-expansion": "^5.0.8",
      "dompurify": "^3.4.11",
      "@opentelemetry/core": "^2.8.0",
      "protobufjs": "^7.6.3",
      "form-data": "^4.0.6",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
