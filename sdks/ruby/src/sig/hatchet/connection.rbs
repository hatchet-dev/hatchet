module Hatchet
  module Connection
    DEFAULT_CHANNEL_OPTIONS: Hash[String, Integer]
    COMPROMISED_ROOT_FINGERPRINTS: Array[String]
    CERTIFICATE_PEM_PATTERN: Regexp
    TRUTHY_ENV_VALUES: Array[String]

    def self.new_channel: (Config config) -> untyped
    def self.build_credentials: (TLSConfig tls_config) -> untyped
