{
  "name": "@hatchet-dev/pi-durable",
  "version": "0.1.0",
  "private": false,
  "description": "Run pi-durable agents on Hatchet: tools in Hatchet sandboxes, one owner per session, failover and wake-ups.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hatchet-dev/hatchet.git",
    "directory": "sdks/typescript-pi-durable"
  },
  "type": "module",
  "sideEffects": true,
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:sdk": "cd ../typescript && pnpm install --frozen-lockfile --config.strict-dep-builds=false && pnpm tsc:build && pnpm prepublish",
    "build:sandbox": "cd ../typescript-sandbox && pnpm install --frozen-lockfile && pnpm build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PI_E2E=1 vitest run test/e2e",
    "lint": "pnpm run eslint:check && pnpm run prettier:check",
    "lint:fix": "pnpm run eslint:fix && pnpm run prettier:fix",
    "eslint:check": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"examples/coding-agent/*.ts\"",
    "eslint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"examples/coding-agent/*.ts\" --fix",
    "prettier:check": "prettier \"src/**/*.ts\" \"test/**/*.ts\" \"examples/coding-agent/*.ts\" \"*.md\" --list-different",
    "prettier:fix": "prettier \"src/**/*.ts\" \"test/**/*.ts\" \"examples/coding-agent/*.ts\" \"*.md\" --write",
    "example:worker": "tsx --env-file-if-exists=.env examples/coding-agent/worker.ts",
    "example:server": "tsx --env-file-if-exists=.env examples/coding-agent/server.ts",
    "publish:ci": "pnpm run build && pnpm publish --access public --no-git-checks",
    "publish:ci:alpha": "pnpm run build && pnpm publish --access public --no-git-checks --tag alpha",
    "release:local": "pnpm run build:sdk && pnpm run build:sandbox && pnpm install && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "peerDependencies": {
    "@earendil-works/chord": "~1.5.0",
    "@earendil-works/pi-ai": "~1.5.0",
    "@earendil-works/pi-durable": "~1.5.0",
    "@hatchet-dev/sandbox": ">=0.1.5 <0.2.0",
    "@hatchet-dev/typescript-sdk": ">=1.44.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@eslint/js": "^10.0.1",
    "@hatchet-dev/sandbox": "file:../typescript-sandbox",
    "@hatchet-dev/typescript-sdk": "file:../typescript/dist",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "5.3.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
