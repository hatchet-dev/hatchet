# Hatchet: a token for the tenant, from the dashboard's API tokens page.
HATCHET_CLIENT_TOKEN=
# For a local engine without TLS:
# HATCHET_CLIENT_HOST_PORT=localhost:7070
# HATCHET_CLIENT_TLS_STRATEGY=none
# If the engine's API uses a certificate your system trusts but Node does not (a local mkcert certificate, say).
# Without it, REST calls fail: cancelling an aborted command and scheduling a session's wakeup.
# NODE_OPTIONS=--use-system-ca

# The example's model provider.
ANTHROPIC_API_KEY=

# Optional, for the example.
# PI_MODEL=claude-opus-5-5
# PI_MAX_SESSION_COST_USD=3
# PI_DATA_DIR=.pi-data
# PI_DEBUG=1
# PORT=3334
# The example's server listens on loopback only; set HOST=0.0.0.0 to expose it to the network.
# HOST=127.0.0.1

# Set to 1 to run the ExecutionEnv conformance suite against a real sandbox (pnpm test).
# PI_SANDBOX_TESTS=1
