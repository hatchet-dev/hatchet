{
  "name": "@hatchet-dev/sandbox",
  "version": "0.1.5",
  "private": false,
  "description": "Hatchet Sandbox TypeScript SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hatchet-dev/hatchet.git",
    "directory": "sdks/typescript-sandbox"
  },
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:sdk": "cd ../typescript && pnpm install --frozen-lockfile --config.strict-dep-builds=false && pnpm tsc:build && pnpm prepublish",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "pnpm run eslint:check && pnpm run prettier:check",
    "lint:fix": "pnpm run eslint:fix && pnpm run prettier:fix",
    "eslint:check": "eslint \"src/**/*.ts\" \"examples/**/*.ts\"",
    "eslint:fix": "eslint \"src/**/*.ts\" \"examples/**/*.ts\" --fix",
    "prettier:check": "prettier \"src/**/*.ts\" \"examples/**/*.ts\" \"test/**/*.mjs\" \"*.md\" --list-different",
    "prettier:fix": "prettier \"src/**/*.ts\" \"examples/**/*.ts\" \"test/**/*.mjs\" \"*.md\" --write",
    "publish:ci": "pnpm run build && pnpm publish --access public --no-git-checks",
    "publish:ci:alpha": "pnpm run build && pnpm publish --access public --no-git-checks --tag alpha",
    "release:local": "pnpm run build:sdk && pnpm install && pnpm run lint && pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "peerDependencies": {
    "@hatchet-dev/typescript-sdk": ">=1.33.1"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hatchet-dev/typescript-sdk": "file:../typescript/dist",
    "@types/node": "^26.6.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
