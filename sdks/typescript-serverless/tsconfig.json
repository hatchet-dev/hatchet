{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // The handler is written against WinterCG globals (Request, Response, Headers, crypto).
    // Cloudflare's typings provide them without pulling in the DOM or Node, and the
    // Cloudflare adapter types its return value against ExportedHandler from the same file.
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
