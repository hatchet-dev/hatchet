{
  "name": "hatchet-serverless-nextjs",
  "private": true,
  "type": "module",
  "description": "Example Hatchet serverless endpoint in a Next.js App Router app on Vercel",
  "scripts": {
    "dev": "next dev",
    "dev:vercel": "vercel dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "vendor": "./scripts/vendor.sh",
    "deploy": "pnpm run vendor && vercel deploy --prod",
    "consume-stream": "node --env-file-if-exists=.env.local scripts/consume-stream.ts"
  },
  "dependencies": {
    "@hatchet-dev/serverless": "file:./vendor/hatchet-dev-serverless.tgz",
    "@hatchet-dev/typescript-sdk": "file:./vendor/hatchet-dev-typescript-sdk.tgz",
    "@vercel/functions": "^3.9.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.6.0"
  }
}
